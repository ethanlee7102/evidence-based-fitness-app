.claude/

# Dated dataset backups (git history already preserves prior versions)
*.bak
*.bak.*

# Eval result artifacts. Keep the canonical reports and headline baselines; ignore the
# large near-duplicate experiment scratch (fixtures, per-config runs, judge dumps).
apps/api/results/*
!apps/api/results/*.md
!apps/api/results/run2_binary_baseline.json
!apps/api/results/citation_validity_sgnorm015.json
!apps/api/results/deterministic_checks_sgnorm015.json
!apps/api/results/target_chunks_baseline.json
!apps/api/results/rag_outputs_fixture_sgnorm015_full.json
!apps/api/results/noise_review/
apps/api/results/noise_review/*
!apps/api/results/noise_review/final_verdict.json
